{
  "extends": "tsconfig/base.json",
  "compilerOptions": {
    "outDir": "../dist/server",
    "rootDir": "./src",
    "lib": ["ES2015", "ES2017"],
    "target": "ES2017",
    "downlevelIteration": true,
    "types": ["node"]
  },
  "include": ["src/**/*"],
  "exclude": ["src/**/*.test.ts", "src/**/__tests__/**/*"]
}